# Copy into local .env.local or configure these in Vercel project settings.
# Never commit actual credentials.

# Existing application database
DATABASE_URL=

# Canonical public app URL
NEXT_PUBLIC_APP_URL=https://linkwell-ten.vercel.app

# Managed Neon Auth (Better Auth)
NEON_AUTH_BASE_URL=https://ep-jolly-wave-b5z9naj1.neonauth.c-7.us-east-2.aws.neon.tech/linkwell/auth
# Generate a random secret of at least 32 characters; never commit its real value.
NEON_AUTH_COOKIE_SECRET=

# Transitional only: legacy custom auth endpoints still use these until migration is complete.
BREVO_API_KEY=
LINKWELL_FROM_EMAIL=

# Private object storage for CVs (planned)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Payment provider keys must be added only after provider and settlement are confirmed.
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
