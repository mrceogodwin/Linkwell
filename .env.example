# Copy into .env.local or configure in the existing Vercel project settings.
# Never commit real credentials.

# Neon PostgreSQL connection string used by server-side database queries.
DATABASE_URL=

# Required for the currently implemented email verification and sign-in links.
BREVO_API_KEY=
LINKWELL_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The Neon Auth variables previously configured in Vercel are for an unmerged
# migration and are not used by the current main-branch email-link auth flow.

